<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Accessible Navigation</title>

  <!-- Leaflet -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f6fa;
      color: #172033;
    }

    header {
      background: #174c3c;
      color: white;
      padding: 20px;
      text-align: center;
    }

    header h1 {
      margin: 0 0 6px;
    }

    header p {
      margin: 0;
      font-size: 14px;
    }

    .container {
      max-width: 1000px;
      margin: 24px auto;
      padding: 0 16px;
    }

    .panel {
      background: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 16px;
      box-shadow: 0 2px 10px #0000000d;
    }

    label {
      display: block;
      font-weight: bold;
      margin: 12px 0 6px;
    }

    input,
    select {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccd3dd;
      border-radius: 7px;
      font-size: 15px;
      background: white;
    }

    button {
      border: none;
      border-radius: 7px;
      padding: 12px 16px;
      margin: 12px 6px 0 0;
      cursor: pointer;
      font-size: 14px;
      font-weight: bold;
      background: #17694e;
      color: white;
    }

    button:hover {
      opacity: 0.9;
    }

    button.secondary {
      background: #e6eee9;
      color: #174c3c;
    }

    button.accent {
      background: #7a4d00;
      color: white;
    }

    button:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    #map {
      width: 100%;
      height: 440px;
      border-radius: 12px;
      z-index: 1;
    }

    #status {
      margin-top: 12px;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-top: 16px;
    }

    .stat {
      background: #edf5f0;
      padding: 16px;
      border-radius: 8px;
    }

    .stat strong {
      display: block;
      font-size: 22px;
      margin-top: 6px;
    }

    .hint {
      color: #586575;
      font-size: 13px;
      line-height: 1.5;
    }

    .instructions {
      margin-top: 20px;
    }

    .instructions ol {
      padding-left: 25px;
    }

    .instructions li {
      margin-bottom: 10px;
      line-height: 1.5;
    }

    .tactile {
      background: #fff7df;
      border-left: 5px solid #d99a00;
      padding: 14px;
      border-radius: 7px;
      margin-top: 16px;
    }

    .tactile strong {
      display: block;
      margin-bottom: 5px;
    }

    .success {
      color: #17694e;
      font-weight: bold;
    }

    .warning {
      color: #9a6700;
      font-weight: bold;
    }

    footer {
      text-align: center;
      padding: 20px;
      color: #586575;
      font-size: 12px;
    }

    @media (max-width: 700px) {
      #map {
        height: 350px;
      }

      .panel {
        padding: 14px;
      }

      .stats {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

<header>
  <h1>Accessible Navigation</h1>
  <p>Find a route with walking, driving, voice guidance and accessibility information.</p>
</header>

<main class="container">

  <!-- Journey planning -->
  <section class="panel">

    <h2>Plan Your Journey</h2>

    <label for="mode">Travel Mode</label>

    <select id="mode" onchange="onModeChanged()">
      <option value="walking" selected>
        Walking (Pedestrian & Sidewalks)
      </option>

      <option value="driving">
        Driving (Vehicle)
      </option>
    </select>

    <label for="start">Starting Point</label>

    <input
      id="start"
      type="text"
      placeholder="e.g. Universiti Malaya, Kuala Lumpur"
    >

    <label for="destination">Destination</label>

    <input
      id="destination"
      type="text"
      placeholder="e.g. KL Sentral, Kuala Lumpur"
    >

    <button
      id="routeBtn"
      type="button"
      onclick="findRoute()"
    >
      Find Route
    </button>

    <button
      class="secondary"
      type="button"
      onclick="useMyLocation()"
    >
      Use My Location
    </button>

    <button
      class="accent"
      type="button"
      onclick="toggleVoiceAnnouncements()"
    >
      Toggle Voice Guidance:
      <span id="voiceStatus">ON</span>
    </button>

    <button
      class="secondary"
      type="button"
      onclick="clearRoute()"
    >
      Clear
    </button>

    <div
      id="status"
      role="status"
      aria-live="polite"
    >
      Enter your starting point and destination to begin.
    </div>

    <div class="stats">

      <div class="stat">
        Distance
        <strong id="distance">—</strong>
      </div>

      <div class="stat">
        Estimated Duration
        <strong id="duration">—</strong>
      </div>

      <div class="stat">
        Tactile Paths Detected
        <strong id="tactileCount">—</strong>
      </div>

    </div>

    <div
      id="tactileMessage"
      class="tactile"
      style="display:none;"
    ></div>

    <p class="hint">
      Route estimates depend on OpenStreetMap data and the routing service.
      Tactile-path information is only shown when OpenStreetMap contains
      relevant accessibility tags. This is a learning project, not an
      emergency navigation service.
    </p>

  </section>


  <!-- Map -->
  <section class="panel">

    <h2>Map</h2>

    <div id="map"></div>

    <button
      id="googleBtn"
      type="button"
      class="secondary"
      onclick="openGoogleMaps()"
      disabled
    >
      Open Route in Google Maps
    </button>

  </section>


  <!-- Directions -->
  <section
    id="instructionsPanel"
    class="panel instructions"
    style="display:none;"
  >

    <h2>Route Instructions</h2>

    <ol id="instructionsList"></ol>

  </section>

</main>


<footer>
  Map data © OpenStreetMap contributors.
  Routing by OpenStreetMap/FOSSGIS routing services.
</footer>


<!-- Leaflet -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

  /*
   * ============================================================
   * ACCESSIBLE NAVIGATION APPLICATION
   * ============================================================
   */


  // ------------------------------------------------------------
  // 1. MAP SETUP
  // ------------------------------------------------------------

  const map = L.map("map").setView(
    [3.139, 101.6869],
    12
  );


  L.tileLayer(
    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
      maxZoom: 19,

      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">' +
        'OpenStreetMap contributors</a>'
    }
  ).addTo(map);


  // ------------------------------------------------------------
  // 2. GLOBAL VARIABLES
  // ------------------------------------------------------------

  let startMarker = null;

  let destinationMarker = null;

  let routeLine = null;

  let tactileLayer = null;

  let startCoords = null;

  let destinationCoords = null;

  let currentRoute = null;

  let voiceEnabled = true;

  let currentInstructions = [];

  const locationCache = new Map();


  // ------------------------------------------------------------
  // 3. DOM ELEMENTS
  // ------------------------------------------------------------

  const statusBox =
    document.getElementById("status");

  const routeButton =
    document.getElementById("routeBtn");

  const googleButton =
    document.getElementById("googleBtn");

  const instructionsPanel =
    document.getElementById("instructionsPanel");

  const instructionsList =
    document.getElementById("instructionsList");

  const tactileMessage =
    document.getElementById("tactileMessage");


  // ------------------------------------------------------------
  // 4. STATUS
  // ------------------------------------------------------------

  function setStatus(message) {
    statusBox.textContent = message;
  }


  // ------------------------------------------------------------
  // 5. RESET RESULTS
  // ------------------------------------------------------------

  function resetResults() {

    document.getElementById("distance").textContent = "—";

    document.getElementById("duration").textContent = "—";

    document.getElementById("tactileCount").textContent = "—";

    googleButton.disabled = true;

    instructionsPanel.style.display = "none";

    instructionsList.innerHTML = "";

    tactileMessage.style.display = "none";

    tactileMessage.innerHTML = "";
  }


  // ------------------------------------------------------------
  // 6. TRAVEL MODE
  // ------------------------------------------------------------

  function onModeChanged() {

    const mode =
      document.getElementById("mode").value;

    if (mode === "walking") {

      document.getElementById("destination").placeholder =
        "e.g. KL Sentral, Kuala Lumpur";

      setStatus(
        "Walking mode selected. Walking routes will use pedestrian paths where available."
      );

    } else {

      setStatus(
        "Driving mode selected. Routes will use roads suitable for vehicles."
      );
    }
  }


  // ------------------------------------------------------------
  // 7. GEOCODING
  // ------------------------------------------------------------

  async function geocode(place) {

    const key =
      place.trim().toLowerCase();


    // Allow direct coordinates.
    const coordinateMatch =
      place.match(
        /^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/
      );


    if (coordinateMatch) {

      return {
        lat: Number(coordinateMatch[1]),
        lon: Number(coordinateMatch[2]),
        name: place
      };
    }


    // Use cache when possible.
    if (locationCache.has(key)) {

      return locationCache.get(key);
    }


    // Respect Nominatim's public-service rate limit.
    if (geocode.lastRequest) {

      const wait =
        1100 -
        (Date.now() - geocode.lastRequest);

      if (wait > 0) {

        await new Promise(
          resolve => setTimeout(resolve, wait)
        );
      }
    }


    geocode.lastRequest = Date.now();


    const url =
      "https://nominatim.openstreetmap.org/search" +
      "?format=jsonv2" +
      "&limit=1" +
      "&q=" +
      encodeURIComponent(place);


    const response =
      await fetch(url);


    if (!response.ok) {

      throw new Error(
        "The location search service is unavailable. Please try again."
      );
    }


    const results =
      await response.json();


    if (!results.length) {

      throw new Error(
        'Location not found: "' +
        place +
        '". Try adding the city or state.'
      );
    }


    const result = {

      lat: Number(results[0].lat),

      lon: Number(results[0].lon),

      name: results[0].display_name
    };


    locationCache.set(
      key,
      result
    );


    return result;
  }


  // ------------------------------------------------------------
  // 8. DISPLAY LOCATIONS
  // ------------------------------------------------------------

  function displayLocations(
    start,
    destination
  ) {

    if (startMarker) {

      map.removeLayer(startMarker);
    }


    if (destinationMarker) {

      map.removeLayer(destinationMarker);
    }


    startMarker =
      L.marker([
        start.lat,
        start.lon
      ])
      .addTo(map)
      .bindPopup(
        "<strong>Starting Point</strong>"
      )
      .openPopup();


    destinationMarker =
      L.marker([
        destination.lat,
        destination.lon
      ])
      .addTo(map)
      .bindPopup(
        "<strong>Destination</strong>"
      );


    const bounds =
      L.latLngBounds(
        [start.lat, start.lon],
        [destination.lat, destination.lon]
      );


    map.fitBounds(
      bounds,
      {
        padding: [35, 35]
      }
    );
  }


  // ------------------------------------------------------------
  // 9. ROUTING
  // ------------------------------------------------------------

  async function getRoute(
    start,
    destination
  ) {

    const mode =
      document.getElementById("mode").value;


    /*
     * FOSSGIS provides separate routing servers
     * for car and foot routing.
     *
     * Both use the OSRM HTTP API.
     */

    let routingServer;


    if (mode === "walking") {

      routingServer =
        "https://routing.openstreetmap.de/routed-foot";

    } else {

      routingServer =
        "https://routing.openstreetmap.de/routed-car";
    }


    const coordinates =
      start.lon +
      "," +
      start.lat +
      ";" +
      destination.lon +
      "," +
      destination.lat;


    const url =
      routingServer +
      "/route/v1/driving/" +
      coordinates +
      "?overview=full" +
      "&geometries=geojson" +
      "&steps=true" +
      "&alternatives=false";


    const response =
      await fetch(url);


    if (!response.ok) {

      throw new Error(
        "The routing service is unavailable. Please try again."
      );
    }


    const data =
      await response.json();


    if (
      data.code !== "Ok" ||
      !data.routes ||
      !data.routes.length
    ) {

      throw new Error(
        "No suitable route was found."
      );
    }


    return data.routes[0];
  }


  // ------------------------------------------------------------
  // 10. ROUTE INSTRUCTIONS
  // ------------------------------------------------------------

  function getInstructionText(step) {

    const maneuver =
      step.maneuver || {};

    const type =
      maneuver.type || "";

    const modifier =
      maneuver.modifier || "";

    const roadName =
      step.name ||
      "the unnamed road";


    if (type === "depart") {

      return (
        "Start by heading " +
        directionText(modifier) +
        " on " +
        roadName +
        "."
      );
    }


    if (type === "arrive") {

      return "You have arrived at your destination.";
    }


    if (type === "roundabout") {

      if (maneuver.exit) {

        return (
          "At the roundabout, take exit " +
          maneuver.exit +
          " onto " +
          roadName +
          "."
        );
      }

      return (
        "Enter the roundabout and continue onto " +
        roadName +
        "."
      );
    }


    if (type === "fork") {

      return (
        "At the fork, keep " +
        directionText(modifier) +
        " onto " +
        roadName +
        "."
      );
    }


    if (
      type === "turn" ||
      type === "continue" ||
      type === "new name"
    ) {

      if (type === "continue") {

        return (
          "Continue " +
          directionText(modifier) +
          " on " +
          roadName +
          "."
        );
      }


      return (
        "Turn " +
        directionText(modifier) +
        " onto " +
        roadName +
        "."
      );
    }


    return (
      "Continue on " +
      roadName +
      "."
    );
  }


  function directionText(modifier) {

    const directions = {

      left: "left",

      right: "right",

      straight: "straight",

      "slight left": "slightly left",

      "slight right": "slightly right",

      "sharp left": "sharply left",

      "sharp right": "sharply right",

      uturn: "around"
    };


    return (
      directions[modifier] ||
      "ahead"
    );
  }


  // ------------------------------------------------------------
  // 11. SHOW INSTRUCTIONS
  // ------------------------------------------------------------

  function displayInstructions(route) {

    instructionsList.innerHTML = "";

    currentInstructions = [];


    const legs =
      route.legs || [];


    legs.forEach(
      leg => {

        const steps =
          leg.steps || [];


        steps.forEach(
          step => {

            const text =
              getInstructionText(step);


            currentInstructions.push(text);


            const li =
              document.createElement("li");

            li.textContent =
              text;


            if (step.distance) {

              const distance =
                formatDistance(
                  step.distance
                );


              li.textContent +=
                " (" +
                distance +
                ")";
            }


            instructionsList.appendChild(li);
          }
        );
      }
    );


    if (currentInstructions.length) {

      instructionsPanel.style.display =
        "block";
    }
  }


  // ------------------------------------------------------------
  // 12. DISTANCE FORMATTING
  // ------------------------------------------------------------

  function formatDistance(
    meters
  ) {

    if (meters < 1000) {

      return (
        Math.round(meters) +
        " m"
      );
    }


    return (
      (meters / 1000)
        .toFixed(2) +
      " km"
    );
  }


  // ------------------------------------------------------------
  // 13. DRAW ROUTE
  // ------------------------------------------------------------

  function drawRoute(route) {

    if (routeLine) {

      map.removeLayer(routeLine);
    }


    routeLine =
      L.geoJSON(
        route.geometry,
        {
          style: {
            color: "#1769ff",
            weight: 6,
            opacity: 0.85
          }
        }
      )
      .addTo(map);


    map.fitBounds(
      routeLine.getBounds(),
      {
        padding: [35, 35]
      }
    );
  }


  // ------------------------------------------------------------
  // 14. MAIN ROUTING FUNCTION
  // ------------------------------------------------------------

  async function findRoute() {

    const startText =
      document
        .getElementById("start")
        .value
        .trim();


    const destinationText =
      document
        .getElementById("destination")
        .value
        .trim();


    if (!startText || !destinationText) {

      setStatus(
        "Please enter both a starting point and a destination."
      );

      return;
    }


    routeButton.disabled = true;

    routeButton.textContent =
      "Finding Route...";


    resetResults();


    try {

      setStatus(
        "Searching for the starting point..."
      );


      const start =
        await geocode(startText);


      setStatus(
        "Searching for the destination..."
      );


      const destination =
        await geocode(destinationText);


      startCoords = start;

      destinationCoords =
        destination;


      displayLocations(
        start,
        destination
      );


      const mode =
        document
          .getElementById("mode")
          .value;


      setStatus(
        mode === "walking"
          ? "Calculating the walking route..."
          : "Calculating the driving route..."
      );


      const route =
        await getRoute(
          start,
          destination
        );


      currentRoute =
        route;


      drawRoute(route);


      const km =
        route.distance / 1000;


      const minutes =
        Math.round(
          route.duration / 60
        );


      document
        .getElementById("distance")
        .textContent =
        km.toFixed(2) +
        " km";


      document
        .getElementById("duration")
        .textContent =
        minutes >= 60
          ? Math.floor(minutes / 60) +
            " hr " +
            (minutes % 60) +
            " min"
          : minutes +
            " min";


      googleButton.disabled =
        false;


      displayInstructions(
        route
      );


      /*
       * Search for tactile paths only for walking.
       */

      if (mode === "walking") {

        await findTactilePaths(
          route
        );

      } else {

        document
          .getElementById("tactileCount")
          .textContent =
          "N/A";

        tactileMessage.style.display =
          "block";

        tactileMessage.innerHTML =
          "<strong>Tactile Path Information</strong>" +
          "Tactile-path detection is available for walking routes.";
      }


      setStatus(
        "Route found successfully."
      );


      /*
       * Read the first instruction aloud.
       */

      if (
        voiceEnabled &&
        currentInstructions.length
      ) {

        speak(
          "Route found. " +
          currentInstructions[0]
        );
      }

    } catch (error) {

      console.error(error);


      setStatus(
        error.message ||
        "Something went wrong."
      );

    } finally {

      routeButton.disabled =
        false;

      routeButton.textContent =
        "Find Route";
    }
  }


  // ------------------------------------------------------------
  // 15. TACTILE PATH DETECTION
  // ------------------------------------------------------------

  async function findTactilePaths(
    route
  ) {

    /*
     * OpenStreetMap tactile information can be
     * represented using tags such as:
     *
     * tactile_paving=yes
     * tactile_paving=contrasted
     *
     * We query a small area around the route.
     */

    if (tactileLayer) {

      map.removeLayer(
        tactileLayer
      );

      tactileLayer = null;
    }


    const coordinates =
      route.geometry.coordinates;


    if (
      !coordinates ||
      coordinates.length === 0
    ) {

      return;
    }


    let minLat = Infinity;
    let maxLat = -Infinity;
    let minLon = Infinity;
    let maxLon = -Infinity;


    coordinates.forEach(
      coordinate => {

        const lon =
          coordinate[0];

        const lat =
          coordinate[1];


        minLat =
          Math.min(
            minLat,
            lat
          );


        maxLat =
          Math.max(
            maxLat,
            lat
          );


        minLon =
          Math.min(
            minLon,
            lon
          );


        maxLon =
          Math.max(
            maxLon,
            lon
          );
      }
    );


    /*
     * Add a small buffer.
     */

    const buffer =
      0.0015;


    minLat -= buffer;

    maxLat += buffer;

    minLon -= buffer;

    maxLon += buffer;


    const query = `
      [out:json][timeout:15];

      (
        node["tactile_paving"](${minLat},${minLon},${maxLat},${maxLon});

        way["tactile_paving"](${minLat},${minLon},${maxLat},${maxLon});

        node["highway"="footway"]["tactile_paving"](${minLat},${minLon},${maxLat},${maxLon});

        way["highway"="footway"]["tactile_paving"](${minLat},${minLon},${maxLat},${maxLon});
      );

      out center tags;
    `;


    try {

      const response =
        await fetch(
          "https://overpass-api.de/api/interpreter",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/x-www-form-urlencoded"
            },

            body:
              "data=" +
              encodeURIComponent(query)
          }
        );


      if (!response.ok) {

        throw new Error(
          "Tactile-path service unavailable."
        );
      }


      const data =
        await response.json();


      const elements =
        data.elements || [];


      /*
       * Remove duplicate IDs.
       */

      const unique =
        new Map();


      elements.forEach(
        element => {

          unique.set(
            element.type +
            "-" +
            element.id,
            element
          );
        }
      );


      const tactileElements =
        Array.from(
          unique.values()
        );


      document
        .getElementById("tactileCount")
        .textContent =
        tactileElements.length;


      if (
        tactileElements.length === 0
      ) {

        tactileMessage.style.display =
          "block";

        tactileMessage.innerHTML =
          "<strong>No mapped tactile paths found</strong>" +
          "OpenStreetMap does not currently contain " +
          "mapped tactile-paving information in the searched route area. " +
          "This does not mean tactile paths are absent in reality.";

        return;
      }


      /*
       * Display tactile features.
       */

      tactileLayer =
        L.layerGroup()
          .addTo(map);


      tactileElements.forEach(
        element => {

          let lat;
          let lon;


          if (
            typeof element.lat === "number"
          ) {

            lat =
              element.lat;

            lon =
              element.lon;

          } else if (
            element.center
          ) {

            lat =
              element.center.lat;

            lon =
              element.center.lon;

          }


          if (
            typeof lat !== "number" ||
            typeof lon !== "number"
          ) {

            return;
          }


          const value =
            element.tags &&
            element.tags.tactile_paving
              ? element.tags.tactile_paving
              : "yes";


          L.circleMarker(
            [lat, lon],
            {
              radius: 7,

              color: "#7a4d00",

              fillColor: "#ffd66b",

              fillOpacity: 0.9,

              weight: 2
            }
          )
          .bindPopup(
            "<strong>Tactile Path</strong><br>" +
            "OpenStreetMap tag: " +
            value
          )
          .addTo(
            tactileLayer
          );
        }
      );


      tactileMessage.style.display =
        "block";


      tactileMessage.innerHTML =
        "<strong>Tactile paths detected: " +
        tactileElements.length +
        "</strong>" +
        "The highlighted accessibility features are based on " +
        "OpenStreetMap data. Always verify the physical path " +
        "conditions while travelling.";


    } catch (error) {

      console.warn(
        "Tactile detection failed:",
        error
      );


      document
        .getElementById("tactileCount")
        .textContent =
        "Unavailable";


      tactileMessage.style.display =
        "block";


      tactileMessage.innerHTML =
        "<strong>Tactile information unavailable</strong>" +
        "The route itself was calculated successfully, " +
        "but tactile-path information could not be retrieved.";
    }
  }


  // ------------------------------------------------------------
  // 16. VOICE GUIDANCE
  // ------------------------------------------------------------

  function toggleVoiceAnnouncements() {

    voiceEnabled =
      !voiceEnabled;


    document
      .getElementById("voiceStatus")
      .textContent =
      voiceEnabled
        ? "ON"
        : "OFF";


    if (!voiceEnabled) {

      window.speechSynthesis.cancel();

      setStatus(
        "Voice guidance turned off."
      );

    } else {

      setStatus(
        "Voice guidance turned on."
      );
    }
  }


  function speak(text) {

    if (
      !voiceEnabled ||
      !("speechSynthesis" in window)
    ) {

      return;
    }


    window.speechSynthesis.cancel();


    const utterance =
      new SpeechSynthesisUtterance(
        text
      );


    utterance.rate =
      0.9;

    utterance.pitch =
      1;

    utterance.volume =
      1;


    window.speechSynthesis.speak(
      utterance
    );
  }


  // ------------------------------------------------------------
  // 17. CURRENT LOCATION
  // ------------------------------------------------------------

  function useMyLocation() {

    if (
      !navigator.geolocation
    ) {

      setStatus(
        "Your browser does not support location services."
      );

      return;
    }


    setStatus(
      "Requesting your current location..."
    );


    navigator.geolocation.getCurrentPosition(

      position => {

        const lat =
          position.coords.latitude;

        const lon =
          position.coords.longitude;


        startCoords = {
          lat,
          lon,
          name: "Current location"
        };


        document
          .getElementById("start")
          .value =
          lat.toFixed(6) +
          ", " +
          lon.toFixed(6);


        map.setView(
          [lat, lon],
          16
        );


        if (startMarker) {

          map.removeLayer(
            startMarker
          );
        }


        startMarker =
          L.marker(
            [lat, lon]
          )
          .addTo(map)
          .bindPopup(
            "<strong>Your Current Location</strong>"
          )
          .openPopup();


        setStatus(
          "Your current location has been added as the starting point. Enter a destination and find the route."
        );
      },


      error => {

        const messages = {

          1:
            "Location permission was denied. Allow location access in your browser.",

          2:
            "Your location is currently unavailable.",

          3:
            "The location request timed out."
        };


        setStatus(
          messages[error.code] ||
          "Could not get your location."
        );
      },


      {
        enableHighAccuracy: true,

        timeout: 10000,

        maximumAge: 60000
      }
    );
  }


  // ------------------------------------------------------------
  // 18. GOOGLE MAPS
  // ------------------------------------------------------------

  function openGoogleMaps() {

    if (
      !startCoords ||
      !destinationCoords
    ) {

      return;
    }


    const mode =
      document
        .getElementById("mode")
        .value;


    const travelMode =
      mode === "walking"
        ? "walking"
        : "driving";


    const url =
      "https://www.google.com/maps/dir/?api=1" +

      "&origin=" +
      encodeURIComponent(
        startCoords.lat +
        "," +
        startCoords.lon
      ) +

      "&destination=" +
      encodeURIComponent(
        destinationCoords.lat +
        "," +
        destinationCoords.lon
      ) +

      "&travelmode=" +
      travelMode;


    window.open(
      url,
      "_blank",
      "noopener,noreferrer"
    );
  }


  // ------------------------------------------------------------
  // 19. CLEAR ROUTE
  // ------------------------------------------------------------

  function clearRoute() {

    if (startMarker) {

      map.removeLayer(
        startMarker
      );
    }


    if (destinationMarker) {

      map.removeLayer(
        destinationMarker
      );
    }


    if (routeLine) {

      map.removeLayer(
        routeLine
      );
    }


    if (tactileLayer) {

      map.removeLayer(
        tactileLayer
      );
    }


    startMarker = null;

    destinationMarker = null;

    routeLine = null;

    tactileLayer = null;

    startCoords = null;

    destinationCoords = null;

    currentRoute = null;

    currentInstructions = [];


    window.speechSynthesis.cancel();


    document
      .getElementById("start")
      .value = "";


    document
      .getElementById("destination")
      .value = "";


    resetResults();


    setStatus(
      "Map cleared. Enter a new journey to begin."
    );


    map.setView(
      [3.139, 101.6869],
      12
    );
  }


  // ------------------------------------------------------------
  // 20. KEYBOARD ACCESSIBILITY
  // ------------------------------------------------------------

  document
    .getElementById("start")
    .addEventListener(
      "keydown",
      event => {

        if (event.key === "Enter") {

          findRoute();
        }
      }
    );


  document
    .getElementById("destination")
    .addEventListener(
      "keydown",
      event => {

        if (event.key === "Enter") {

          findRoute();
        }
      }
    );


</script>

